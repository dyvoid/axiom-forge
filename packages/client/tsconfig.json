{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"noEmit": true,
		"useDefineForClassFields": true
	},
	"include": ["src/**/*", "vite.config.ts"],
	"exclude": ["dist", "node_modules"]
}
